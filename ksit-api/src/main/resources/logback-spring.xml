<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="appName"    source="spring.application.name" defaultValue="ks-it-school"/>
    <springProperty scope="context" name="appVersion" source="app.version"             defaultValue="1.0.0"/>

    <property name="CONSOLE_PATTERN"
              value="%clr(%d{HH:mm:ss.SSS}){faint} %clr(%-5level){highlight} %clr(%-35.35logger{35}){cyan} %clr([%X{traceId:--}]){blue} %msg%n"/>

    <property name="FILE_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %-35.35logger{35} [%X{traceId:--}] %msg%n"/>

    <property name="FILE_ERROR_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} ERROR  %-35.35logger{35} [%X{traceId:--}] %msg%n%ex{full}%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${CONSOLE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="INFO_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/ks-it-info.log</file>

        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>DENY</onMatch>
            <onMismatch>ACCEPT</onMismatch>
        </filter>

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/%d{yyyy-MM-dd}/ks-it-info-%d{yyyy-MM-dd-hh-a}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>

        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/ks-it-error.log</file>

        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/%d{yyyy-MM-dd}/ks-it-error-%d{yyyy-MM-dd-hh-a}.log</fileNamePattern>
            <maxHistory>90</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>

        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${FILE_ERROR_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="ASYNC_INFO" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
        <appender-ref ref="INFO_FILE"/>
    </appender>

    <appender name="ASYNC_ERROR" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>256</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>true</includeCallerData>
        <appender-ref ref="ERROR_FILE"/>
    </appender>

    <logger name="com.menghor.ksit" level="INFO" additivity="true"/>

    <logger name="org.springframework"                 level="WARN"/>
    <logger name="org.springframework.web"             level="WARN"/>
    <logger name="org.springframework.security"        level="WARN"/>
    <logger name="org.springframework.data"            level="WARN"/>
    <logger name="org.hibernate"                       level="WARN"/>
    <logger name="org.hibernate.SQL"                   level="WARN"/>
    <logger name="org.hibernate.type.descriptor.sql"   level="WARN"/>
    <logger name="org.apache.catalina"                 level="WARN"/>
    <logger name="org.apache.tomcat"                   level="WARN"/>
    <logger name="org.apache.coyote"                   level="WARN"/>
    <logger name="com.github.benmanes.caffeine"        level="WARN"/>
    <logger name="io.lettuce.core"                     level="WARN"/>
    <logger name="org.springframework.data.redis"      level="WARN"/>
    <logger name="com.zaxxer.hikari"                   level="WARN"/>
    <logger name="liquibase"                           level="WARN"/>
    <logger name="org.flywaydb"                        level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ASYNC_INFO"/>
        <appender-ref ref="ASYNC_ERROR"/>
    </root>

</configuration>
